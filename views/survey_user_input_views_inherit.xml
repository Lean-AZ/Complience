<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Habilitar corrección completa desde la vista estándar de participaciones -->
    <record id="survey_user_input_view_form_compliance_edit" model="ir.ui.view">
        <field name="name">survey.user_input.view.form.compliance.edit</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="arch" type="xml">
            <!-- Mantener visible todo, pero permitir edición de respuestas -->
            <xpath expr="//field[@name='user_input_line_ids']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="mode">tree,form</attribute>
            </xpath>
        </field>
    </record>
</odoo>

