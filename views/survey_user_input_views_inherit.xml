<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Permitir edición de líneas de respuestas desde el backend para R-06 -->
    <record id="survey_user_input_view_form_compliance_edit" model="ir.ui.view">
        <field name="name">survey.user_input.view.form.compliance.edit</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="arch" type="xml">
            <!-- Ocultar botón Imprimir en participaciones -->
            <xpath expr="//button[@name='action_print_answers']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_input_line_ids']" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="mode">tree,form</attribute>
            </xpath>
            <!-- Ocultar basurero (eliminar línea) -->
            <xpath expr="//field[@name='user_input_line_ids']/tree" position="attributes">
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>

