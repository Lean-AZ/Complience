<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ghr_compliance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ghr.compliance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='contacts_settings']" position="after">
                <div id="ghr_compliance_settings">
                    <block title="Compliance (PLAFT)" name="ghr_compliance_setting_container">
                        <setting id="ghr_compliance_gemini_api_key_setting" string="Dictamen con IA (Gemini)" help="Clave API de Google AI Studio para generar dictámenes de Oficial de Cumplimiento. Sin clave se usa solo el dictamen por reglas internas." groups="base.group_system" title="API Key de Gemini para dictámenes PLAFT">
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="ghr_compliance_gemini_api_key"/>
                                    <field name="ghr_compliance_gemini_api_key" password="True" placeholder="Pegar API Key..."/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
