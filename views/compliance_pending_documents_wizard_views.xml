<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_compliance_pending_documents_wizard_form" model="ir.ui.view">
        <field name="name">compliance.pending.documents.wizard.form</field>
        <field name="model">compliance.pending.documents.wizard</field>
        <field name="arch" type="xml">
            <form string="Documentos pendientes (KYC)" version="7.0">
                <sheet>
                    <group>
                        <field name="assessment_id" readonly="1"/>
                    </group>
                    <separator string="Pendientes" colspan="4"/>
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="title" readonly="1"/>
                            <field name="required" readonly="1"/>
                            <field name="deadline" readonly="1"/>
                            <field name="file_data" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="mimetype" invisible="1"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Guardar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

