<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_compliance_assessment" model="ir.sequence">
            <field name="name">Secuencia de Evaluación PLAFT</field>
            <field name="code">compliance.assessment</field>
            <field name="prefix">EVAL-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="param_dealer_cash_limit" model="ir.config_parameter">
            <field name="key">ghr_compliance.dealer_cash_limit</field>
            <field name="value">15000</field>
        </record>
        <record id="param_reminder_days" model="ir.config_parameter">
            <field name="key">ghr_compliance.reminder_days</field>
            <field name="value">7</field>
        </record>
        <record id="param_validity_months" model="ir.config_parameter">
            <field name="key">ghr_compliance.validity_months</field>
            <field name="value">12</field>
        </record>
        <record id="ir_cron_remind_pending_assessments" model="ir.cron">
            <field name="name">Compliance: recordatorio encuestas pendientes</field>
            <field name="model_id" ref="model_compliance_assessment"/>
            <field name="state">code</field>
            <field name="code">model._cron_remind_pending_assessments()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!-- Perfiles de umbrales por defecto: el operador puede modificarlos desde Compliance > Configuración -->
        <record id="profile_default" model="compliance.risk.profile">
            <field name="name">Default</field>
            <field name="volume_limit_usd">15000</field>
            <field name="transfer_count_limit">3</field>
            <field name="score_threshold_medium">36</field>
            <field name="score_threshold_high">71</field>
            <!-- Pesos base equivalentes a los defaults del modelo -->
            <field name="weight_origin_funds">0.30</field>
            <field name="weight_economic_activity">0.25</field>
            <field name="weight_pep">0.20</field>
            <field name="weight_nationality">0.15</field>
            <field name="weight_transaction_bulto">0.10</field>
        </record>

        <!-- Perfil alineado a escenario de Vinculación inicial:
             Cliente (origen, actividad, PEP) pesa algo más que Geografía y Transaccional -->
        <record id="profile_kyc_initial_engagement" model="compliance.risk.profile">
            <field name="name">Perfil KYC - Vinculación inicial</field>
            <field name="volume_limit_usd">15000</field>
            <field name="transfer_count_limit">3</field>
            <field name="score_threshold_medium">36</field>
            <field name="score_threshold_high">71</field>
            <!-- Suma 1.0: 0.25 + 0.20 + 0.15 + 0.20 + 0.20 -->
            <field name="weight_origin_funds">0.25</field>
            <field name="weight_economic_activity">0.20</field>
            <field name="weight_pep">0.15</field>
            <field name="weight_nationality">0.20</field>
            <field name="weight_transaction_bulto">0.20</field>
        </record>

        <!-- Perfil alineado a escenario de Monitoreo continuo:
             se incrementa el peso del comportamiento transaccional -->
        <record id="profile_kyc_continuous_monitoring" model="compliance.risk.profile">
            <field name="name">Perfil KYC - Monitoreo continuo</field>
            <field name="volume_limit_usd">15000</field>
            <field name="transfer_count_limit">3</field>
            <field name="score_threshold_medium">36</field>
            <field name="score_threshold_high">71</field>
            <!-- Suma 1.0: 0.20 + 0.15 + 0.15 + 0.20 + 0.30 -->
            <field name="weight_origin_funds">0.20</field>
            <field name="weight_economic_activity">0.15</field>
            <field name="weight_pep">0.15</field>
            <field name="weight_nationality">0.20</field>
            <field name="weight_transaction_bulto">0.30</field>
        </record>

        <record id="profile_constructora" model="compliance.risk.profile">
            <field name="name">Constructora</field>
            <field name="volume_limit_usd">400000</field>
            <field name="transfer_count_limit">3</field>
            <field name="score_threshold_medium">36</field>
            <field name="score_threshold_high">71</field>
            <!-- Se parte de los mismos pesos base; el usuario puede ajustarlos -->
            <field name="weight_origin_funds">0.30</field>
            <field name="weight_economic_activity">0.25</field>
            <field name="weight_pep">0.20</field>
            <field name="weight_nationality">0.15</field>
            <field name="weight_transaction_bulto">0.10</field>
        </record>
        <record id="profile_dealer" model="compliance.risk.profile">
            <field name="name">Dealer</field>
            <field name="volume_limit_usd">15000</field>
            <field name="transfer_count_limit">3</field>
            <field name="score_threshold_medium">36</field>
            <field name="score_threshold_high">71</field>
            <field name="weight_origin_funds">0.30</field>
            <field name="weight_economic_activity">0.25</field>
            <field name="weight_pep">0.20</field>
            <field name="weight_nationality">0.15</field>
            <field name="weight_transaction_bulto">0.10</field>
        </record>
    </data>

    <data>
        <record id="q_origen_efectivo" model="compliance.question">
            <field name="name">¿El origen de los fondos es efectivo de fuentes no declaradas?</field>
            <field name="category">ambos</field>
            <field name="weight">10</field>
        </record>

        <record id="q_pep_directo" model="compliance.question">
            <field name="name">¿El cliente es una Persona Expuesta Políticamente (PEP)?</field>
            <field name="category">ambos</field>
            <field name="weight">8</field>
        </record>
    </data>
</odoo>